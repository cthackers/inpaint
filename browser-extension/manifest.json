{
  "key": "",
  "manifest_version": 3,
  "name": "Inpaint",
  "description": "Inpaint integration extension",
  "version": "1.0",
  "icons": {
    "32": "icon.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/inpaint/background.js",
    "type": "module"
  },
  "options_page": "src/inpaint/options.html",
  "commands": {
    "toggle-inpaint-panel": {
      "suggested_key": { "default": "Alt+Shift+I" },
      "description": "Show or hide the Inpaint panel"
    }
  },
  "content_scripts": [
    {
      "js": ["src/inpaint/content.js", "src/inpaint/panel.js"],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    },
    {
      "js": ["src/scripts/image-upgrade.js"],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}
