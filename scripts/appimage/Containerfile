# Build environment for the portable AppImage. An AppImage bundles the GTK and WebKitGTK libraries of the
# system that built it, and those only load where glibc is at least as new as on that system. Building on
# Ubuntu 22.04 (glibc 2.35) lets the AppImage run on Linux Mint 21, Ubuntu 22.04, Debian 12 and newer.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl file pkg-config xz-utils \
        libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev \
        libdbus-1-dev libx11-dev libxdo-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# The newest Node.js 22 release, for the frontend build and the Tauri CLI.
RUN archive="$(curl -fsSL https://nodejs.org/dist/latest-v22.x/SHASUMS256.txt | grep -o 'node-v[0-9.]*-linux-x64.tar.xz' | head -n 1)" \
    && curl -fsSL "https://nodejs.org/dist/latest-v22.x/$archive" | tar -xJ -C /opt \
    && mv /opt/node-v*-linux-x64 /opt/node

# Toolchains are read-only for the build user; registry and build caches go to the mounted cache folder.
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable \
    && chmod -R a+rX /opt/rustup /opt/cargo
ENV PATH=/opt/cargo/bin:/opt/node/bin:$PATH
